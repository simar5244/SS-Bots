{
  "appId": "com.aiservices.app",
  "productName": "AI Services",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    ".next/**/*",
    "app/**/*",
    "lib/**/*",
    "components/**/*",
    "models/**/*",
    "public/**/*",
    "electron/**/*",
    "backend/**/*",
    "node_modules/**/*",
    "package.json",
    "next.config.js",
    "tsconfig.json",
    "tailwind.config.js",
    "postcss.config.js",
    ".env",
    "!node_modules/**/{CHANGELOG.md,README.md,readme.md,readme,test,__tests__,tests,powered-test,example,examples}",
    "!node_modules/**/{*.d.ts,*.map,*.ts.map}",
    "!node_modules/.bin",
    "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
    "!.editorconfig",
    "!**/._*",
    "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
    "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
    "!**/{appveyor.yml,.travis.yml,circle.yml}",
    "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
  ],
  "asarUnpack": [
    "node_modules/**/*",
    ".next/**/*"
  ],
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "compression": "maximum",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.productivity",
    "artifactName": "${productName}-${version}-mac.${ext}",
    "icon": "build/icon-512.png",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "extendInfo": {
      "LSUIElement": true
    }
  },
  "nsis": {
    "oneClick": false,
    "allowElevation": true,
    "perMachine": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AI Services",
    "deleteAppDataOnUninstall": true,
    "uninstallDisplayName": "AI Services",
    "runAfterFinish": true
  }
}
